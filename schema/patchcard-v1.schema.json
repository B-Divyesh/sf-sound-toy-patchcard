{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-toy-patchcard.sociobot.in/schema/patchcard-v1.schema.json",
  "title": "Patchcard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "name", "createdAt", "toy", "parameters"],
  "properties": {
    "format": { "const": "patchcard" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "createdAt": { "type": "string", "format": "date-time" },
    "description": { "type": "string" },
    "toy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "version": { "type": "string" }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "value"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$" },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "boolean"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "unit": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
            }
          }
        }
      }
    },
    "waveform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "samples"],
      "properties": {
        "kind": { "const": "samples" },
        "samples": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "type": "number", "minimum": -1, "maximum": 1 } }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime", "data", "license", "creator", "source"],
      "properties": {
        "mime": { "const": "audio/wav" },
        "data": { "type": "string", "minLength": 1, "maxLength": 20000000 },
        "license": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
