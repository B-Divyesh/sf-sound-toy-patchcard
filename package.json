{
  "name": "@sociobot/patchcard",
  "version": "0.1.0",
  "description": "Portable, private-by-default cards for browser sound toys",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./schema.json": "./schema/patchcard-v1.schema.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/style.css",
    "schema",
    "docs/format.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:lib": "tsup",
    "build:site:app": "vite build --config site/vite.config.ts",
    "build:download": "node scripts/build-download.mjs",
    "build:site": "npm run build:lib && npm run build:site:app && npm run build:download",
    "build": "npm run clean && npm run build:site",
    "test": "vitest run",
    "test:claims": "playwright test browser-tests/claims.spec.ts",
    "test:a11y": "playwright test browser-tests/accessibility.spec.ts",
    "test:browser": "playwright test",
    "test:release": "node scripts/verify-release-identity.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:release && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
